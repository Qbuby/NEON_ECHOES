; Engine configuration file.
; Starter template for agent-driven Godot 4 development.
; Keep this file readable: agents edit it directly.

config_version=5

[application]

config/name="NEON ECHOES"
config/description="Neon Echoes is an isometric pixel-art cyberpunk action RPG."
run/main_scene="res://scenes/iso_demo.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.0862745, 0.0705882, 0.121569, 1)
boot_splash/show_image=false

[autoload]

Log="*res://src/autoload/log.gd"
GameState="*res://src/autoload/game_state.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
SceneManager="*res://src/autoload/scene_manager.gd"
Playtest="*res://src/autoload/playtest.gd"
UxProbe="*res://src/autoload/ux_probe.gd"
Juice="*res://src/fx/juice.gd"
Rain="*res://src/fx/rain.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

